  "denial_scenarios": {
    "documentation_missing": {
      "label": "Documentation Missing",
      "description": "Clinical notes lack required elements for payer approval",
      "typical_carc": ["16","197"],
      "typical_rarc": ["N1","N479"],
      "resolution": "Supplement with specific missing clinical documentation"
    },
    "not_medically_necessary": {
      "label": "Not Medically Necessary",
      "description": "Payer determines service not clinically justified",
      "typical_carc": ["204","167"],
      "typical_rarc": ["N115"],
      "resolution": "Request peer-to-peer review. Provide additional clinical evidence."
    },
    "prior_auth_missing": {
      "label": "Prior Authorization Missing",
      "description": "Service performed without required prior authorization",
      "typical_carc": ["4","197","119"],
      "typical_rarc": ["N4","N479"],
      "resolution": "File retrospective authorization or appeal with clinical justification"
    },
    "wrong_facility": {
      "label": "Wrong Facility Type",
      "description": "Service performed at facility not approved by payer for procedure",
      "typical_carc": ["5"],
      "typical_rarc": ["N130"],
      "resolution": "Transfer case to approved facility or request exception with clinical justification"
    },
    "eligibility_issue": {
      "label": "Eligibility / Coverage Issue",
      "description": "Patient not covered on date of service or incorrect payer",
      "typical_carc": ["15","27"],
      "typical_rarc": ["N56","MA61"],
      "resolution": "Verify eligibility. Check coordination of benefits."
    },
    "timely_filing": {
      "label": "Timely Filing Exceeded",
      "description": "Claim submitted beyond payer's filing deadline",
      "typical_carc": ["29"],
      "typical_rarc": ["M86"],
      "resolution": "File appeal with proof of timely filing documentation"
    },
    "bundling": {
      "label": "Bundling / Duplicate",
      "description": "Service included in payment for another procedure",
      "typical_carc": ["97","18"],
      "typical_rarc": ["N104"],
      "resolution": "Review coding. Unbundle if appropriate. Add modifier if separate service."
    }
  },

