  "carc_rarc_mappings": {
    "note": "CARC = Claim Adjustment Reason Code | RARC = Remittance Advice Remark Code",
    "carc": {
      "4":   {"category": "Prior Auth Required",       "description": "Service requires prior authorization"},
      "5":   {"category": "Coordination of Benefits",  "description": "Procedure code/bill type mismatch"},
      "11":  {"category": "Not Covered",               "description": "Service not covered by plan"},
      "15":  {"category": "Eligibility Issue",         "description": "Patient not eligible on date of service"},
      "16":  {"category": "Documentation Missing",     "description": "Claim lacks required information"},
      "18":  {"category": "Duplicate Claim",           "description": "Previously adjudicated claim"},
      "22":  {"category": "Coordination of Benefits",  "description": "This care may be covered by another payer"},
      "27":  {"category": "Eligibility Issue",         "description": "Expenses incurred after coverage ended"},
      "29":  {"category": "Timely Filing",             "description": "Claim not filed in timely manner"},
      "45":  {"category": "Contractual Adjustment",    "description": "Charge exceeds fee schedule"},
      "96":  {"category": "Not Covered",               "description": "Non-covered charge(s)"},
      "97":  {"category": "Bundling",                  "description": "Included in allowance for another procedure"},
      "119": {"category": "Prior Auth Required",       "description": "Benefit maximum reached for period"},
      "167": {"category": "Not Covered",               "description": "This diagnosis is not covered"},
      "197": {"category": "Prior Auth Required",       "description": "Precertification/authorization absent"},
      "204": {"category": "Not Medically Necessary",   "description": "Service, equipment, drugs not covered/justified"}
    },
    "rarc": {
      "N1":   {"category": "Documentation Missing",   "description": "Additional information required"},
      "N4":   {"category": "Prior Auth Required",      "description": "Missing/incomplete/invalid prior auth"},
      "N56":  {"category": "Eligibility Issue",        "description": "Incomplete/invalid patient ID"},
      "N104": {"category": "Bundling",                 "description": "Service included in global surgical package"},
      "N115": {"category": "Not Medically Necessary",  "description": "This decision was based on clinical guidelines"},
      "N130": {"category": "Not Covered",              "description": "Consult plan benefit documents for restrictions"},
      "N362": {"category": "Documentation Missing",    "description": "Additional payment or credits cannot be applied"},
      "N479": {"category": "Prior Auth Required",      "description": "A prior authorization number is required"},
      "M86":  {"category": "Timely Filing",            "description": "Service denied because plan hasn't been established"},
      "MA61": {"category": "Eligibility Issue",        "description": "Patient not identified as insured"}
    }
  },

